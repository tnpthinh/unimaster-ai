# Environment configuration template
# Copy to .env and fill in your values
PORT=8080
GEMINI_API_KEY=
# OpenAI chính thức hoặc gateway OpenAI-compatible (9Router)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI: gpt-4o. 9Router: All (tổng quát) hoặc Coding-Pro (lập trình).
OPENAI_MODEL=gpt-4o
AI_PROVIDER_PRIORITY=openai_first
# Khi Render gọi 9Router qua Cloudflare Tunnel: đặt base URL local ở trên,
# app sẽ dò URL tunnel mới nhất ở discovery URL và gửi secret bảo vệ.
AI_GATEWAY_DISCOVERY_URL=
AI_GATEWAY_SECRET=
APP_PASSWORD=
# Optional: automatic SQLite backup to a private Telegram chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_BACKUP_CHAT_ID=
TELEGRAM_BACKUP_INTERVAL_HOURS=24
