# Environment configuration template
# Copy to .env and fill in your values (NEVER commit .env!)
PORT=8080
# Comma-separated Gemini API keys for server-side pool & rotation (AQ.Ab8... and/or AIzaSy...)
GEMINI_API_KEYS=
GEMINI_API_KEY=
# 9Router / OpenAI-compatible Gateway (aliases ROUTER_* and OPENAI_* are both supported)
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=All
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI: gpt-4o. 9Router: All (tổng quát) hoặc Coding-Pro (lập trình). FOSTA: gpt-6.1-sol
OPENAI_MODEL=gpt-4o
# Routing priority: gemini_first | openai_first | gemini_only | openai_only
AI_PROVIDER_PRIORITY=gemini_first
# Khi Render gọi 9Router qua Cloudflare Tunnel: đặt base URL local ở trên,
# app sẽ dò URL tunnel mới nhất ở discovery URL và gửi secret bảo vệ.
AI_GATEWAY_DISCOVERY_URL=
AI_GATEWAY_SECRET=
# Security: set APP_PASSWORD (or REQUIRE_AUTH=1) for internet/cloud deployments
APP_PASSWORD=
REQUIRE_AUTH=0
# Optional: automatic SQLite backup to a private Telegram chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_BACKUP_CHAT_ID=
TELEGRAM_BACKUP_INTERVAL_HOURS=24
